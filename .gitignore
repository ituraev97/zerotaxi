# Служебная папка Netlify CLI
.netlify/

# Зависимости (в самом сайте их нет, но tools/ и локальный netlify dev их ставят)
node_modules/

# Локальные переменные окружения. Секреты живут в настройках проекта на Netlify,
# в репозиторий они не попадают — он публичный.
.env
.env.*
!.env.example

.DS_Store
