# Копия для локальной разработки: cp .env.example .env, затем впишите значения.
# .env в git не попадает (см. .gitignore). В проде секреты задаются в Netlify:
# Project configuration → Environment variables.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Куда слать заявки: личный chat id (см. @userinfobot) или -100... для группы/канала
TELEGRAM_CHAT_ID=

# Meta Pixel / Conversions API (Facebook). Задаются в Netlify, не обязательны
# локально — без них серверное событие Lead просто не отправляется.
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=

# ID счётчика Яндекс.Метрики. Справочно: сайт статический, без сборки,
# поэтому в HTML это значение прописано напрямую (var YM_COUNTER_ID в <head>
# каждой страницы), а не читается из окружения в рантайме. Меняя ID,
# правьте его во всех *.html (или заведите сборку/Edge Function, если
# понадобится единая точка правки).
YM_COUNTER_ID=111268041
