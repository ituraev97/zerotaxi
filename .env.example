# Копия для локальной разработки: cp .env.example .env, затем впишите значения.
# .env в git не попадает (см. .gitignore). В проде секреты задаются в Netlify:
# Project configuration → Environment variables.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Куда слать заявки: личный chat id (см. @userinfobot) или -100... для группы/канала
TELEGRAM_CHAT_ID=
